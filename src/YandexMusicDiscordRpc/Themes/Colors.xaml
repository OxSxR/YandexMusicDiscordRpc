<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="SymbolFont">Segoe UI Symbol, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0E1014" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#14171D" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171A21" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#1D222B" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#242A35" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2A303C" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#222833" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8AFBD" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#727B8C" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FFDB4D" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFE680" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#E8C63B" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#16181D" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="#2A2512" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#655722" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="DotOffBrush" Color="#5B6373" />
    <SolidColorBrush x:Key="CoverPlaceholderBrush" Color="#232936" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#CC0E1014" />

</ResourceDictionary>
