<Window x:Class="YandexMusicDiscordRpc.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Настройки — Yandex Music RPC"
        Width="600"
        Height="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/app.ico"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Border Margin="14"
            Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="9"
                              Opacity="0.55"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    CornerRadius="20,20,0,0"
                    MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid Margin="22,0,14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙"
                                   FontFamily="{StaticResource SymbolFont}"
                                   FontSize="19"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Настройки"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Yandex Music RPC"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Button Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="Close_OnClick"
                            ToolTip="Закрыть">
                        <TextBlock Text="✕" FontFamily="{StaticResource SymbolFont}" FontSize="14" />
                    </Button>
                </Grid>
            </Border>

            <!-- Содержимое -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,18,24,18">

                    <TextBlock Text="ОБЩИЕ" Style="{StaticResource SectionLabelStyle}" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Запускать вместе с Windows"
                                               Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Приложение будет автоматически запускаться при входе в систему."
                                               Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding StartWithWindows}"
                                          Margin="18,0,0,0" />
                            </Grid>

                            <Border Style="{StaticResource SeparatorLineStyle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Сворачивать в трей"
                                               Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Кнопка закрытия будет скрывать окно, а приложение продолжит работу."
                                               Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding MinimizeToTray}"
                                          Margin="18,0,0,0" />
                            </Grid>

                            <Border Style="{StaticResource SeparatorLineStyle}" />

                            <Grid IsEnabled="{Binding StartMinimizedEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Запускать свёрнутым"
                                               Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="При запуске окно сразу будет скрыто в системный трей."
                                               Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding StartMinimized}"
                                          Margin="18,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DISCORD"
                               Style="{StaticResource SectionLabelStyle}"
                               Margin="2,22,0,8" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Включить Rich Presence"
                                               Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Показывать текущий трек в профиле Discord."
                                               Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding EnableRichPresence}"
                                          Margin="18,0,0,0" />
                            </Grid>

                            <Border Style="{StaticResource SeparatorLineStyle}" />

                            <StackPanel IsEnabled="{Binding EnableRichPresence}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Показывать обложку"
                                                   Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Обложка альбома загружается из каталога Яндекс Музыки."
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding ShowCover}"
                                              Margin="18,0,0,0" />
                                </Grid>

                                <Border Style="{StaticResource SeparatorLineStyle}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Показывать прогресс трека"
                                                   Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Discord синхронизирует шкалу времени с воспроизведением."
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding ShowProgress}"
                                              Margin="18,0,0,0" />
                                </Grid>

                                <Border Style="{StaticResource SeparatorLineStyle}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Отображать кнопки"
                                                   Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Кнопки «Открыть трек» и «Исполнитель» при наличии ссылок."
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding ShowButtons}"
                                              Margin="18,0,0,0" />
                                </Grid>

                                <Border Style="{StaticResource SeparatorLineStyle}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Название трека в статусе"
                                                   Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="Показывать в строке статуса название песни вместо «Яндекс Музыка»."
                                                   Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding ShowTrackNameInStatus}"
                                              Margin="18,0,0,0" />
                                </Grid>
                            </StackPanel>

                            <Border Style="{StaticResource SeparatorLineStyle}" />

                            <TextBlock Text="Discord Application ID"
                                       Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock Text="По умолчанию используется публичное приложение «Яндекс Музыка». Можно указать собственное."
                                       Style="{StaticResource SettingDescriptionStyle}"
                                       Margin="0,4,0,9" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding DiscordClientId, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource LinkButtonStyle}"
                                        Command="{Binding UseDefaultClientIdCommand}"
                                        Content="Сбросить"
                                        Margin="9,0,0,0"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                <Hyperlink Foreground="{StaticResource AccentBrush}"
                                           TextDecorations="None"
                                           NavigateUri="https://discord.com/developers/applications"
                                           RequestNavigate="Hyperlink_OnRequestNavigate">Где взять Application ID?</Hyperlink>
                            </TextBlock>

                            <TextBlock Text="{Binding ValidationMessage}"
                                       FontSize="11"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ЯНДЕКС МУЗЫКА"
                               Style="{StaticResource SectionLabelStyle}"
                               Margin="2,22,0,8" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Источник данных"
                                       Style="{StaticResource SettingTitleStyle}" />
                            <TextBlock Text="Откуда приложение получает информацию о воспроизведении."
                                       Style="{StaticResource SettingDescriptionStyle}"
                                       Margin="0,4,0,10" />

                            <RadioButton GroupName="Source"
                                         Style="{StaticResource SourceOptionStyle}"
                                         IsChecked="{Binding UseAutoSource}">
                                <StackPanel>
                                    <TextBlock Text="Автоматически" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Сначала приложение, затем веб-версия"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="Source"
                                         Style="{StaticResource SourceOptionStyle}"
                                         IsChecked="{Binding UseWebSource}">
                                <StackPanel>
                                    <TextBlock Text="Веб-версия" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Браузер с открытой Яндекс Музыкой"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="Source"
                                         Style="{StaticResource SourceOptionStyle}"
                                         IsChecked="{Binding UseDesktopSource}"
                                         Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Десктопное приложение" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Официальное приложение Яндекс Музыки для Windows"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <Border Style="{StaticResource SeparatorLineStyle}" Margin="0,14,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Загружать обложку и ссылки"
                                               Style="{StaticResource SettingTitleStyle}" />
                                    <TextBlock Text="Необязательный запрос к каталогу Яндекс Музыки для кнопок и обложки."
                                               Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding EnrichFromCatalog}"
                                          Margin="18,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="О ПРИЛОЖЕНИИ"
                               Style="{StaticResource SectionLabelStyle}"
                               Margin="2,22,0,8" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Yandex Music RPC"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding VersionText}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Text="Приложение не заменяет Яндекс Музыку и Discord: оно читает данные Windows Media Session и передаёт их в Discord Rich Presence."
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="Веб-версия определяется по заголовку окна браузера. Если Яндекс Музыка играет в неактивной вкладке, Windows может не сообщить об этом."
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="17"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Подвал -->
            <Border Grid.Row="2"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,20,20">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Изменения применяются после сохранения"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Отмена"
                                Width="104"
                                Click="Cancel_OnClick" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="Сохранить"
                                Width="116"
                                Margin="10,0,0,0"
                                Click="Save_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
