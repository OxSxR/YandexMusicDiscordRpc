<Window x:Class="YandexMusicDiscordRpc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Yandex Music RPC"
        Width="500"
        Height="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Border Margin="14"
            Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="9"
                              Opacity="0.55"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    CornerRadius="20,20,0,0"
                    MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid Margin="20,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               Width="38"
                               Height="38"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Yandex Music RPC"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Discord Rich Presence"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip="Настройки">
                            <TextBlock Text="⚙" FontFamily="{StaticResource SymbolFont}" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Margin="2,0,0,0"
                                Click="Minimize_OnClick"
                                ToolTip="Свернуть">
                            <TextBlock Text="—" FontFamily="{StaticResource SymbolFont}" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Margin="2,0,0,0"
                                Click="Close_OnClick"
                                ToolTip="Закрыть">
                            <TextBlock Text="✕" FontFamily="{StaticResource SymbolFont}" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Содержимое -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,16,24,16">

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="128" Height="128">
                                <Border Background="{StaticResource CoverPlaceholderBrush}"
                                        CornerRadius="14" />
                                <TextBlock Text="♫"
                                           FontFamily="{StaticResource SymbolFont}"
                                           FontSize="50"
                                           Foreground="#4B5466"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Image Source="{Binding CoverImage}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,128,128" RadiusX="14" RadiusY="14" />
                                    </Image.Clip>
                                    <Image.Style>
                                        <Style TargetType="{x:Type Image}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasCover}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <Border BorderBrush="#2DFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        IsHitTestVisible="False" />
                            </Grid>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Border Style="{StaticResource PillStyle}" Margin="0,0,0,9">
                                    <TextBlock Text="{Binding PlaybackStateText}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <TextBlock Text="{Binding TrackTitle}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           MaxHeight="58"
                                           LineHeight="25" />
                                <TextBlock Text="{Binding TrackArtist}"
                                           FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="{Binding TrackAlbum}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0"
                                           Visibility="{Binding HasAlbum, Converter={StaticResource BoolToVisibility}}" />

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource LinkButtonStyle}"
                                            Command="{Binding OpenTrackCommand}"
                                            Content="Открыть трек ↗"
                                            Visibility="{Binding HasTrackUrl, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource LinkButtonStyle}"
                                            Command="{Binding OpenArtistCommand}"
                                            Content="Исполнитель ↗"
                                            Margin="10,0,0,0"
                                            Visibility="{Binding HasArtistUrl, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ProgressBar Style="{StaticResource AccentProgressBarStyle}"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Margin="0,18,0,0" />
                    <Grid Margin="0,9,0,0">
                        <TextBlock Text="{Binding PositionText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding DurationText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,12,0,0" />

                    <!-- Состояние -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="16,14">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,9,0">
                                        <Ellipse.Style>
                                            <Style TargetType="{x:Type Ellipse}">
                                                <Setter Property="Fill" Value="{StaticResource DotOffBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DiscordState}" Value="Connected">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DiscordState}" Value="Connecting">
                                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DiscordState}" Value="Error">
                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DiscordState}" Value="Disconnected">
                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="Discord" FontSize="13" />
                                </StackPanel>
                                <TextBlock Text="{Binding DiscordStatusText}"
                                           FontSize="13"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DiscordState}" Value="Connected">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DiscordState}" Value="Error">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Border Style="{StaticResource SeparatorLineStyle}" Margin="0,11" />

                            <Grid>
                                <TextBlock Text="Источник" FontSize="13" />
                                <TextBlock Text="{Binding SourceText}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="60,0,0,0" />
                            </Grid>

                            <Border Style="{StaticResource SeparatorLineStyle}" Margin="0,11" />

                            <Grid>
                                <TextBlock Text="Воспроизведение" FontSize="13" />
                                <TextBlock Text="{Binding PlaybackStateText}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding RestartServiceCommand}"
                                Content="Перезапустить службу" />
                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenSettingsCommand}"
                                Content="Настройки" />
                    </Grid>

                    <TextBlock Text="{Binding RestartStatusText}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,9,0,0"
                               Visibility="{Binding HasRestartStatus, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Подвал -->
            <Border Grid.Row="2"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,20,20">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Работает в фоне"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding VersionText}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
